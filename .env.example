# Template for the local `.env` file — safe to commit (contains no secrets).
# Copy to `.env` in the project root and fill in your key:
#     cp .env.example .env

# --- LLM configuration (required for LLM categorization + coach) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# categorize_core.make_openai_llm_call() accepts either name; LLM_API_KEY wins.
# OPENAI_API_KEY=

# --- Optional path / runtime overrides (defaults are fine for local runs) ---
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts

# "Today" for a historical (2010s) dataset. Default is the user's max transaction date.
# AS_OF_DATE=2018-02-18
